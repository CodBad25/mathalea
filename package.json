  "scripts": {
    "dev": "pnpm makeJson && vite",
    "start": "pnpm makeJson && vite",
    "buildRam": "pnpm makeJson && NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build": "pnpm makeJson && NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build:analyze": "ANALYZE_BUILD=1 pnpm build",
    "build:deploy": "pnpm build && tasks/deploy_site.sh && open https://coopmaths.fr/alea",
    "deploy:site": "tasks/deploy_site.sh && open https://coopmaths.fr/alea",
    "rollback": "node tasks/rollback_site.js",
    "clean:releases": "node tasks/clean_releases.js",
    "makeJson": "node --experimental-strip-types tasks/dictionnaireToReferentiel.js && node tasks/updateMenuInternational && node tasks/updateQuizzBackgrounds.js",
    "getNewUuid": "pnpm makeJson",
    "updateMenu": "pnpm makeJson",
    "updateMenuCH": "pnpm makeJson",
    "preview": "vite preview",
    "check": "NODE_OPTIONS=--max-old-space-size=8192 pnpm exec svelte-check --tsconfig ./tsconfig.json",
    "check:lib": "svelte-check --tsconfig ./tsconfig.check-lib.json",
    "check:components": "svelte-check --tsconfig ./tsconfig.check-components.json",
    "count:variants": "node tasks/count-variants.js",
    "transpile": "tsc > journal.log",
    "lint": "eslint --fix 'src/exercices/**/*.{js,ts}'",
    "lintSvelte": "eslint --fix 'src/components/**/*.{js,ts}'",
    "codemod:amc-questions": "node tasks/codemod-amc-questions.js",
    "codemod:amc-questions:apply": "node tasks/codemod-amc-questions.js --apply",
    "format": "pnpm exec prettier --write src && pnpm exec prettier --write tasks && pnpm exec prettier --write tests",
    "addDNB": "pnpm --package=git+https://forge.apps.education.fr/coopmaths/dnb -c dlx dnbindex",
    "update:ffjm": "node tasks/update-ffjm.js",
    "test:unit": "vitest tests/unit --run --exclude .pnpm-store",
    "test:src": "vitest src --run --exclude .pnpm-store",
    "test:coverage": "vitest --run --coverage --exclude .pnpm-store",
    "test:coverage:unit": "vitest tests/unit --run --coverage --exclude .pnpm-store",
    "test:coverage:src": "vitest src --run --coverage --exclude .pnpm-store",
    "test:e2e": "pnpm test:e2e:all",
    "test:e2e:dev": "vitest --config tests/e2e/vitest.config.dev.js --watch",
    "test:e2e:all": "NIV='' vitest --config tests/e2e/vitest.config.all.js --run",
    "test:e2e:all_exercises": "vitest --config tests/e2e/vitest.config.all_exercises.js tests/all_exercises/all_exercises.test.ts --run",
    "test:e2e:interactivity": "vitest --config tests/e2e/vitest.config.interactivity.js --run",
    "test:e2e:pdfexports": "vitest --config tests/e2e/vitest.config.pdfexports.js --run",
    "test:e2e:latex_compile": "vitest --config tests/e2e/vitest.config.latex_compile.js --run",
    "test:e2e:latex_breaks": "vitest --config tests/e2e/vitest.config.latex_breaks.js --run",
    "test:e2e:console_errors": "vitest --config tests/e2e/vitest.config.console_errors.js --run",
    "test:e2e:console_errors:debug": "vitest --config tests/e2e/vitest.config.console_errors.debug.js --run",
    "test:e2e:views": "vitest --config tests/e2e/vitest.config.viewcan.2024.js --run && vitest --config tests/e2e/vitest.config.view.can.timer-feedback.js --run && vitest --config tests/e2e/vitest.config.view.capytale.review.js --run && vitest --config tests/e2e/vitest.config.view.capytale.save.js --run && vitest --config tests/e2e/vitest.config.view.moodle.review.js --run && vitest --config tests/e2e/vitest.config.view.eleve.can.2025.js --run",
    "test:e2e:consistency": "vitest --config tests/e2e/vitest.config.consistency.js --run",
    "stability:check": "pnpm makeJson && vitest --config tests/e2e/vitest.config.stability.js --run",
    "stability:update": "pnpm makeJson && STABILITY_UPDATE=1 vitest --config tests/e2e/vitest.config.stability.js --run",
    "apigeom-labels:check": "vitest --config tests/e2e/vitest.config.apigeom-labels.js --run",
    "archive": "node tasks/archive-exercice.js",
    "archive:exercice": "node tasks/archive-exercice.js",
    "archive:retro": "node tasks/archive-exercice-retro.js",
    "review:archives": "node tasks/review-archives.js",
    "screenshot": "vitest --config tests/e2e/vitest.config.screenshot.js --run",
    "typst:check": "vitest --config tests/e2e/vitest.config.typst_check.js --run",
    "typst:check:fast": "TYPST_BATCH=1 vitest src/components/setup/typst/typst-batch-check.test.ts --run",
    "typst:check:source": "TYPST_BATCH=1 CHECK_LEVEL=1 vitest src/components/setup/typst/typst-batch-check.test.ts --run",
    "typst:check:compile": "TYPST_BATCH=1 CHECK_LEVEL=2 UNTESTED=1 vitest src/components/setup/typst/typst-batch-check.test.ts --run",
    "typst:inventory": "node --experimental-strip-types tasks/typst-svg-inventory.ts",
    "testExercice": "vitest --config tests/e2e/vitest.config.new_exercise.js --run",
    "test:interactivity": "vitest --config tests/integration/vitest.config.interactivity_all.js --run",
    "test:interactivity:watch": "vitest --config tests/integration/vitest.config.interactivity_all.js",
    "test:exo:file": "NIV=$FILE pnpm test:e2e:console_errors",
    "test:exo:file:headed": "HEADFUL=1 DEBUG=DEBUG SLOWMO=200 NIV=$FILE pnpm test:e2e:console_errors",
    "test:exo:file:debug": "HEADFUL=1 PAUSE_ON_ERROR=1 DEBUG=DEBUG SLOWMO=200 NIV=$FILE pnpm test:e2e:console_errors:debug",
    "prepare": "husky",
    "update:apigeom-snapshots": "node tasks/update-apigeom-snapshots.js",
    "prebuild-unit-tests": "pnpm test:unit && pnpm test:src",
    "prebuild-e2e-tests": "AUTOTEST=true pnpm test:e2e:views && AUTOTEST=true pnpm test:e2e:interactivity && AUTOTEST=true pnpm test:e2e:consistency",
    "test:mr": "pnpm prebuild-unit-tests && pnpm prebuild-e2e-tests"
  },
  "dependencies": {
    "@bugsnag/js": "^8.10.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",

    "instrumenpoche": "git+https://git.sesamath.net/sesamath/instrumenpoche.git",
    "jspreadsheet-ce": "git+https://forge.apps.education.fr/coopmaths/apps/spreadsheet-ce.git",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "mathlive": "^0.110.0",
    "nunjucks": "^3.2.4",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "roughjs": "^4.6.6",
    "scratch-blocks": "^2.1.19",
    "scratchblocks": "^3.7.1",
    "seedrandom": "^3.0.5",
    "socket.io-client": "^4.8.4",
    "sortablejs": "^1.15.7",
    "tex2typst": "^0.6.2",
    "three": "^0.185.1",
    "troika-three-text": "^0.52.5",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/earcut": "^3.0.0",
    "@types/node": "^25.9.5",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "rollup-plugin-visualizer": "^6.0.11",
    "sass": "^1.105.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
